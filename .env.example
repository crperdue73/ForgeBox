# ============================================================================
#  ForgeBox — environment file
#  Copy to `.env` and edit before first run:  cp .env.example .env
#  NEVER commit .env (it holds secrets). It is gitignored.
# ============================================================================

# --- Host / general ---------------------------------------------------------
TZ=America/New_York
PUID=1000
PGID=1000

# Where media + documents live on the host.
MEDIA_PATH=./data/media
PAPERLESS_CONSUME=./data/consume

# --- Security profile -------------------------------------------------------
PIHOLE_PASSWORD=change-me

# Gluetun (privacy VPN for qBittorrent). Fill in for your provider.
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=

# --- DevOps profile ---------------------------------------------------------
# code-server (browser IDE) has NO auth by default upstream; ForgeBox gates it
# with this password. Leave as `change-me` and install.sh auto-generates one.
CODE_SERVER_PASSWORD=change-me

SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=change-me
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@forgebox.local

# --- Productivity profile ---------------------------------------------------
PAPERLESS_DBPASS=change-me
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_URL=http://localhost:8011
PAPERLESS_OCR_LANGUAGE=eng

VIKUNJA_URL=http://localhost:3456
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=change-me

# --- Host ports -------------------------------------------------------------
# Every published port is overridable so a second ForgeBox instance on the
# same host can move its range instead of colliding. Defaults are the
# long-standing values; a single instance needs none of these set.
#
# Second instance on one box:
#   COMPOSE_PROJECT_NAME=forgebox-2
#   FB_PORT_OFFSET is NOT supported — set the individual FB_PORT_* values.

# Project name (shows up in container and volume names):
# COMPOSE_PROJECT_NAME=forgebox

# Portainer web UI
# FB_PORT_PORTAINER=9000
# Heimdall dashboard (HTTP)
# FB_PORT_HEIMDALL=8080
# Heimdall dashboard (HTTPS)
# FB_PORT_HEIMDALL_TLS=8443
# nginx-proxy-manager HTTP
# FB_PORT_NPM=80
# nginx-proxy-manager HTTPS
# FB_PORT_NPM_TLS=443
# nginx-proxy-manager admin UI
# FB_PORT_NPM_ADMIN=81
# Uptime Kuma
# FB_PORT_UPTIME_KUMA=3001
# Glances system monitor
# FB_PORT_GLANCES=61208
# Pi-hole DNS (TCP + UDP, same number)
# FB_PORT_PIHOLE=53
# Pi-hole web admin
# FB_PORT_PIHOLE_WEB=8010
# WireGuard (UDP)
# FB_PORT_WIREGUARD=51820
# Vaultwarden
# FB_PORT_VAULTWARDEN=8020
# Gluetun control server
# FB_PORT_GLUETUN=8888
# Gitea web
# FB_PORT_GITEA=3000
# Gitea SSH
# FB_PORT_GITEA_SSH=2222
# Semaphore UI
# FB_PORT_SEMAPHORE=3010
# Jenkins web
# FB_PORT_JENKINS=8081
# Jenkins agent port
# FB_PORT_JENKINS_AGENT=50000
# code-server (container listens on 8443)
# FB_PORT_CODE_SERVER=8444
# Apache Guacamole
# FB_PORT_GUACAMOLE=8082
# Jellyfin
# FB_PORT_JELLYFIN=8096
# Sonarr
# FB_PORT_SONARR=8989
# Radarr
# FB_PORT_RADARR=7878
# Prowlarr
# FB_PORT_PROWLARR=9696
# qBittorrent
# FB_PORT_QBITTORRENT=8085
# Overseerr
# FB_PORT_OVERSEERR=5055
# Paperless-ngx
# FB_PORT_PAPERLESS=8011
# Vikunja
# FB_PORT_VIKUNJA=3456
# Linkding
# FB_PORT_LINKDING=9090
# n8n
# FB_PORT_N8N=5678
# Nextcloud (container listens on 80, not 443)
# FB_PORT_NEXTCLOUD=8030
# Syncthing web UI
# FB_PORT_SYNCTHING=8384
# Syncthing sync (TCP + UDP, same number)
# FB_PORT_SYNCTHING_SYNC=22000
# Syncthing local discovery (UDP)
# FB_PORT_SYNCTHING_DISC=21027
# Chibisafe (container listens on 8001)
# FB_PORT_CHIBISAFE=8040